  "help": {
    "title": "Help & FAQ",
    "description": "Find answers to common questions or contact our support team.",
    "faqTitle": "Frequently Asked Questions",
    "stillNeedHelp": "Still need help?",
    "emailSupport": "Email Support",
    "privacyPolicy": "Privacy Policy",
    "faq": {
      "q1": "How do I enable two-factor authentication?",
      "a1": "Go to Profile > Security tab and click on \"Enable Two-Factor Authentication\". You'll need an authenticator app like Google Authenticator or Authy to scan the QR code.",
      "q2": "How do I change my password?",
      "a2": "Navigate to Profile > Security tab. If you have a password set, you'll see a \"Change Password\" section. If you signed up with a social provider, you can set a password in the \"Set Password\" section.",
      "q3": "How do I create an organization?",
      "a3": "Go to the Organizations page and click \"Create Organization\". Fill in your organization name and URL slug, then invite team members.",
      "q4": "How do I invite team members?",
      "a4": "From the Organizations page, select your organization and click \"Invite Member\". Enter their email address and select a role.",
      "q5": "How do I upgrade my subscription?",
      "a5": "Visit the Pricing page to see available plans. Click on the plan you want to upgrade to and complete the checkout process.",
      "q6": "How do I manage my billing?",
      "a6": "Go to Pricing and click \"Manage Subscription\" to access the Stripe billing portal where you can update payment methods, view invoices, and cancel your subscription.",
      "q7": "How do I sign out from all devices?",
      "a7": "Go to Profile > Sessions tab. You'll see all your active sessions. Click \"Sign out other sessions\" to terminate all sessions except your current one.",
      "q8": "What happens if I forget my password?",
      "a8": "On the login page, click \"Forgot Password\" and enter your email. You'll receive a password reset link. Alternatively, you can use the Magic Link option to sign in without a password.",
      "q9": "How do I delete my account?",
      "a9": "Account deletion is currently handled through support. Please contact support@authapp.com to request account deletion.",
      "q10": "Is my data secure?",
      "a10": "Yes, we use industry-standard encryption and security practices. Your passwords are hashed, sessions are encrypted, and we support two-factor authentication for additional security."
    }
  },
